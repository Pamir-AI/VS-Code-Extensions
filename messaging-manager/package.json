{
  "name": "distiller-messaging",
  "displayName": "Distiller Messaging",
  "description": "Manage Slack webhook integrations for Distiller devices",
  "version": "1.0.0",
  "publisher": "pamir-ai",
  "icon": "icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pamir-AI/VS-Code-Extensions"
  },
  "bugs": {
    "url": "https://github.com/Pamir-AI/VS-Code-Extensions/issues"
  },
  "homepage": "https://github.com/Pamir-AI/VS-Code-Extensions#readme",
  "keywords": [
    "slack",
    "messaging",
    "webhook",
    "distiller",
    "cm5",
    "notifications",
    "integration"
  ],
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pamir-messaging",
          "title": "Pamir Messaging",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "pamir-messaging": [
        {
          "id": "pamir.messagingView",
          "name": "Slack Integration"
        }
      ]
    },
    "commands": [
      {
        "command": "pamir.setupMessaging",
        "title": "Setup Slack Messaging",
        "category": "Pamir",
        "icon": "$(add)"
      },
      {
        "command": "pamir.viewStatus",
        "title": "View Messaging Status",
        "category": "Pamir",
        "icon": "$(info)"
      },
      {
        "command": "pamir.removeIntegration",
        "title": "Remove Slack Integration",
        "category": "Pamir",
        "icon": "$(trash)"
      },
      {
        "command": "pamir.testMessage",
        "title": "Send Test Message",
        "category": "Pamir",
        "icon": "$(send)"
      },
      {
        "command": "pamir.copyWebhookUrl",
        "title": "Copy Webhook URL",
        "category": "Pamir",
        "icon": "$(link)"
      },
      {
        "command": "pamir.refreshView",
        "title": "Refresh",
        "category": "Pamir",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pamir.refreshView",
          "when": "view == pamir.messagingView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Pamir Messaging",
      "properties": {
        "pamir.messaging.apiUrl": {
          "type": "string",
          "default": "https://messaging.pamir.ai",
          "description": "Messaging API base URL"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package-extension": "npx @vscode/vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/**",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
